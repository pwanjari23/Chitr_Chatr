import React from 'react';
import { formatTime } from '../utils/formatters.js';
import { Check, CheckCheck } from 'lucide-react';

const MessageBubble = ({
  message,
  isOwnMessage
}) => {
  return (
    <div className={`flex flex-col mb-2.5 max-w-[75%] ${isOwnMessage ? 'self-end items-end' : 'self-start items-start'}`}>
      
      {/* Message Text Bubble */}
      <div
        className={`px-4 py-2.5 rounded-2xl shadow-sm select-text text-sm break-words leading-relaxed whitespace-pre-wrap ${
          isOwnMessage
            ? 'bg-brand-500 text-white rounded-tr-none'
            : 'bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 border border-gray-100 dark:border-slate-800 rounded-tl-none'
        }`}
      >
        {message.message}
      </div>

      {/* Timestamp and Seen Indicator Row */}
      <div className={`flex items-center gap-1 mt-1 px-1 text-[10px] font-medium ${isOwnMessage ? 'text-gray-400' : 'text-gray-400 dark:text-slate-500'}`}>
        <span>{formatTime(message.createdAt)}</span>
        
        {isOwnMessage && (
          <span className="flex-shrink-0">
            {message.seen ? (
              <CheckCheck className="w-3.5 h-3.5 text-sky-500" />
            ) : (
              <Check className="w-3.5 h-3.5 text-gray-400" />
            )}
          </span>
        )}
      </div>

    </div>
  );
};

export default MessageBubble;
